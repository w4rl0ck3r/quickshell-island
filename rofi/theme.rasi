/* Tema rofi minimalista, alinhado à paleta da barra (#F8F8F8 / #313131) */
* {
    bg:         #F8F8F8;
    fg:         #313131;
    bg-alt:     #ECECEC;
    border-col: #E7E7E7;
    font: "Inter 11";
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border-col;
    border-radius: 16px;
    width: 480px;
    padding: 14px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 8px 12px;
    children: [ entry ];
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Buscar aplicativos...";
    placeholder-color: #9A9A9A;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg;
    padding: 8px 10px;
    border-radius: 10px;
}

element selected {
    background-color: @bg-alt;
    text-color: @fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 22px;
}
